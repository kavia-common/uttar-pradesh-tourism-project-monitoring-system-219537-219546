# Application
APP_NAME=UPSTDC Project Monitoring API
APP_VERSION=0.1.0
ENV=development
SITE_URL=http://localhost:3000

# Server
HOST=0.0.0.0
PORT=3001

# CORS
CORS_ORIGINS=http://localhost:3000,https://yourdomain.example
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type
CORS_CREDENTIALS=true

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=upstdc

# JWT (use a strong, random value in production)
JWT_SECRET_KEY=dev-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Storage
USE_LOCAL_STORAGE=true
UPLOAD_DIR=uploads

# Frontend/Backend URLs (optional)
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# S3 (optional; required for upload endpoints)
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Rate limit
RATE_LIMIT=100/minute
